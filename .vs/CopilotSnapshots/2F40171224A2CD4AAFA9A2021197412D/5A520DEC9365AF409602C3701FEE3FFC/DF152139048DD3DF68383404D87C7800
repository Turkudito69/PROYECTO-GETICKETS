using Aplication.DTOs;
using Aplication.Interfaces;
using System;
using System.Collections.Generic;
using System.Linq;
using System.Text;
using System.Threading.Tasks;

namespace Aplication.Services
{
    public class LoginServices
    {
        private readonly ILoginRpository _Repository;

        public LoginServices(ILoginRpository Repository)
        {
            _Repository = Repository;
        }

        public async Task<bool> LoginAsync(LoginDTO log)
        {
            var usuario = await _Repository.LoginAsync(log.Correo, log.Contrasena);

            if (usuario == null)
                return false;

            return true;
        }
    }
}
